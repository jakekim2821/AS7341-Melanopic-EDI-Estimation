# 3. AS7341 F1~F8 nominal wavelength ranges

channel_ranges = [
    (405, 425),   # F1
    (435, 455),   # F2
    (470, 490),   # F3
    (505, 525),   # F4
    (545, 565),   # F5
    (580, 600),   # F6
    (620, 640),   # F7
    (670, 690)    # F8
]

# 각 채널의 중심파장
centers = np.array([415, 445, 480, 515, 555, 590, 630, 680], dtype=float)


F = []

for start, end in channel_ranges:
    total = 0.0

    for wavelength in range(start, end + 1):
        total += spdval[wavelength - 380]

    F.append(total)

F = np.array(F, dtype=float)

print("F1~F8 channel values")
for i in range(8):
    print("F" + str(i + 1), "=", F[i])



def interpolate_with_extrapolation(x, x_points, y_points):
    
    if x <= x_points[0]:
        slope = (y_points[1] - y_points[0]) / (x_points[1] - x_points[0])
        return y_points[0] + slope * (x - x_points[0])

    
    if x >= x_points[-1]:
        slope = (y_points[-1] - y_points[-2]) / (x_points[-1] - x_points[-2])
        return y_points[-1] + slope * (x - x_points[-1])

    
    for i in range(len(x_points) - 1):
        if x_points[i] <= x <= x_points[i + 1]:
            slope = (y_points[i + 1] - y_points[i]) / (x_points[i + 1] - x_points[i])
            return y_points[i] + slope * (x - x_points[i])


A = np.zeros((8, 8))

for j in range(8):
    basis = np.zeros(8)
    basis[j] = 1.0

    for i in range(8):
        start, end = channel_ranges[i]
        total = 0.0

        for wavelength in range(start, end + 1):
            total += interpolate_with_extrapolation(
                wavelength,
                centers,
                basis
            )

        A[i, j] = total


center_values = np.linalg.solve(A, F)

print()
print("Solved center SPD values")
for i in range(8):
    print(str(int(centers[i])) + " nm =", center_values[i])


wavelengths = np.arange(405, 691, 1)
estimated_spd = []

for wavelength in wavelengths:
    value = interpolate_with_extrapolation(
        wavelength,
        centers,
        center_values
    )
    estimated_spd.append(value)

estimated_spd = np.array(estimated_spd, dtype=float)


print()
print("Channel total check")

for i in range(8):
    start, end = channel_ranges[i]
    reconstructed_total = 0.0

    for wavelength in range(start, end + 1):
        reconstructed_total += estimated_spd[wavelength - 405]

    difference = reconstructed_total - F[i]

    print(
        "F" + str(i + 1),
        "original =", F[i],
        "reconstructed =", reconstructed_total,
        "difference =", difference
    )


