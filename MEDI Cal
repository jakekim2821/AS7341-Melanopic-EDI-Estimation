for wavelength in wavelengths:
    real_d65.append(spdval[wavelength - 380])

real_d65 = np.array(real_d65, dtype=float)

real_d65_normalized = real_d65 / max(real_d65)
estimated_spd_normalized = estimated_spd / max(estimated_spd)

smel_part = []

for wavelength in wavelengths:
    smel_part.append(Smel[wavelength - 380])

smel_part = np.array(smel_part, dtype=float)

real_product = real_d65_normalized * smel_part
estimated_product = estimated_spd_normalized * smel_part

real_medi = 753.8 * np.trapz(real_product, dx=1)
estimated_medi = 753.8 * np.trapz(estimated_product, dx=1)

error = abs(estimated_medi - real_medi) / real_medi * 100

print()
print("Real D65 melanopic integral =", real_medi)
print("Estimated melanopic integral =", estimated_medi)
print("Error (%) =", error)


